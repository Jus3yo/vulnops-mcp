# Secrets (never commit)
.env
.env.*
!.env.example
*.pem
*.pfx
*.key

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Runtime output (may contain host names, IPs, findings)
logs/*
!logs/.gitkeep
reports/*
!reports/.gitkeep

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
