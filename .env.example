# Copy to .env and fill in. .env is git-ignored. Never commit real values.

# --- Azure (auth comes from your own `az login`; no secrets here) ---
AZURE_TENANT_ID=
# One or more subscription IDs, comma-separated
AZURE_SUBSCRIPTION_IDS=
# Comma-separated resource groups the server may see and act on
VULNOPS_ALLOWED_RESOURCE_GROUPS=

# --- Log Analytics / Sentinel ---
LOG_ANALYTICS_WORKSPACE_ID=
SENTINEL_RESOURCE_GROUP=
SENTINEL_WORKSPACE_NAME=

# --- Tenable Vulnerability Management ---
TENABLE_BASE_URL=https://cloud.tenable.com
TENABLE_ACCESS_KEY=
TENABLE_SECRET_KEY=

# --- Defender for Endpoint ---
DEFENDER_BASE_URL=https://api.securitycenter.microsoft.com

# --- Safety ---
# false = read-only (write tools are not registered)
VULNOPS_ALLOW_WRITES=false
VULNOPS_HONEYPOT_NAME_PATTERNS=*honeypot*,*hpot*,*decoy*
VULNOPS_AUDIT_LOG=logs/audit.jsonl
VULNOPS_LOG_LEVEL=INFO
